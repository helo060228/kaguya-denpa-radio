---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="频段无应答 (404)"
  activeNav=""
  backdrop="/images/route-05-pavilion.jpg"
>
  <section class="denpa-container denpa-notfound">
    <p class="denpa-eyebrow">// SIGNAL LOST · ERROR 404</p>
    <h1 class="denpa-hero-title">频段无应答</h1>
    <p class="denpa-hero-lead" style="margin-inline: auto;">
      你访问的地址似乎在八千年的时空乱流里失去了信号。可以切回主频段重新收听，或进入电波记录翻阅已归档的章节。
    </p>
    <div class="denpa-actions" style="justify-content: center;">
      <a class="denpa-btn-primary" href="/">
        <span>▶ 返回主频段</span>
      </a>
      <a class="denpa-btn-ghost" href="/posts/">查看电波记录</a>
    </div>
  </section>
</BaseLayout>
