---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GALLERY_PLATES } from '../data/gallery';
---

<BaseLayout
  title="回廊"
  activeNav="/gallery/"
  backdrop="/images/route-05-pavilion.jpg"
>
  <section class="denpa-container" style="padding-top: 44px; padding-bottom: 40px;">
    <div class="denpa-section-header">
      <div class="denpa-section-header-left">
        <h1 class="denpa-section-title">回廊</h1>
        <span class="denpa-section-en">GALLERY</span>
      </div>
      <span class="denpa-section-more">共 06 幅官图 · 点击展开暗房预览</span>
    </div>

    <div class="denpa-grid-3">
      {GALLERY_PLATES.map((plate, idx) => (
        <button
          id={plate.id}
          type="button"
          class="denpa-gallery-tile"
          data-lightbox-index={String(idx)}
          data-lightbox-src={plate.src}
          data-lightbox-fig={`${plate.fig} — ${plate.title}`}
          data-lightbox-title={plate.title}
          data-lightbox-caption={plate.caption}
          aria-label={`放大查看 ${plate.fig} ${plate.title}`}
        >
          <img src={plate.src} alt={plate.title} loading="lazy" />
          <div class="denpa-gallery-overlay">
            <span class="denpa-gallery-fig">{plate.fig}</span>
            <span class="denpa-gallery-label">{plate.title}</span>
          </div>
        </button>
      ))}
    </div>
  </section>

  <!-- Exhibition CRT Darkroom Lightbox (Keyboard ←/→ + Pure Art Toggle) -->
  <div id="denpa-lightbox" class="denpa-lightbox" role="dialog" aria-modal="true" aria-label="暗房原画预览">
    <div class="denpa-lightbox-inner">
      <span class="denpa-reticle is-tl" aria-hidden="true"></span>
      <span class="denpa-reticle is-tr" aria-hidden="true"></span>
      <span class="denpa-reticle is-bl" aria-hidden="true"></span>
      <span class="denpa-reticle is-br" aria-hidden="true"></span>

      <div class="denpa-lightbox-topbar">
        <span class="denpa-lightbox-counter" data-lightbox-counter>01 / 06</span>
        <div class="denpa-lightbox-controls">
          <button type="button" class="denpa-lightbox-btn" data-lightbox-crt aria-pressed="false" title="临时隐藏全局扫描线查看无损原画">
            纯原画模式
          </button>
          <button type="button" class="denpa-lightbox-btn" data-lightbox-prev aria-label="上一幅原画">← 上一幅</button>
          <button type="button" class="denpa-lightbox-btn" data-lightbox-next aria-label="下一幅原画">下一幅 →</button>
          <button type="button" class="denpa-lightbox-btn is-close" data-lightbox-close aria-label="关闭预览">ESC 关闭</button>
        </div>
      </div>

      <div class="denpa-lightbox-stage">
        <img data-lightbox-img src="" alt="" />
      </div>

      <div class="denpa-lightbox-meta">
        <span class="denpa-gallery-fig" data-lightbox-fig></span>
        <span class="denpa-lightbox-caption" data-lightbox-caption></span>
      </div>
    </div>
  </div>
</BaseLayout>
