---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BGM_TRACKS } from '../data/bgm';
---

<BaseLayout
  title="关于"
  activeNav="/about/"
  backdrop="/images/route-05-pavilion.jpg"
>
  <section class="denpa-container" style="padding-top: 48px; padding-bottom: 40px;">
    <div class="denpa-section-header">
      <div class="denpa-section-header-left">
        <h1 class="denpa-section-title">关于月读电波台</h1>
        <span class="denpa-section-en">STATION LOG</span>
      </div>
    </div>

    <div class="denpa-about-grid">
      <div class="denpa-about-art">
        <img src="/images/about-triptych.jpg" alt="超时空辉夜姬官方角色三联画（月见八千代、酒寄彩叶、辉夜）" />
      </div>

      <div class="denpa-about-copy">
        <p>
          《超时空辉夜姬！》（超かぐや姫！ / Cosmic Princess Kaguya!）由山下清悟执导，Studio Colorido 与 STUDIO CHROMATO 联手制作，于 2026 年 1 月 22 日正式公开。故事穿梭在近未来东京街角与虚拟空间「月读」之间，把流传千年的《竹取物语》重写成一场向着月光折返的双向奔赴。
        </p>
        <p>
          看完电影的那个深夜，耳机里单曲循环着《Ex-Otogibanashi》和《ray》，总觉得该有一处能安放这些余韵的角落——于是搭起了这座「月读电波台」。站里收拢了角色双形态档案、带剧透防护的八千年因果时间线、九幅官方原画与十首剧内经典原声试听；如果哪一段旋律或台词也曾让你停下脚步，欢迎去电波墙留下一条属于你的深夜讯号。
        </p>

        <ul class="denpa-colophon">
          <li>原作：超かぐや姫！ / 山下清悟 · 夏生さえり</li>
          <li>制作：Studio Colorido × STUDIO CHROMATO</li>
          <li>声优：夏吉优子（辉夜）· 永濑安奈（酒寄彩叶）· 早见沙织（月见八千代）</li>
          <li>架构：Astro 纯静态站 · 阿里云 ECS 持久化电波墙</li>
          <li>收听：点击右上角 ♪ BGM ▾ 可点播 10 首剧内经典原声，或切至深夜白噪频道，切页持续播放不中断。</li>
        </ul>

        <div class="denpa-discography">
          <h2 class="denpa-discography-title">// BROADCAST PLAYLIST · 收录经典曲目与原声（点击试听）</h2>
          <div class="denpa-discography-grid">
            {BGM_TRACKS.map((track) => (
              <div class="denpa-disc-item">
                <div class="denpa-disc-head">
                  <span class="denpa-disc-name">{track.title}</span>
                  <button
                    type="button"
                    class="denpa-disc-play"
                    data-play-bgm={track.id}
                    aria-label={`播放 ${track.title}`}
                  >
                    ▶ 试听
                  </button>
                </div>
                <div class="denpa-disc-foot">
                  <span class="denpa-disc-meta">{track.artist}</span>
                  {track.routeHref && (
                    <a class="denpa-disc-link" href={track.routeHref}>
                      {track.routeHint} →
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
