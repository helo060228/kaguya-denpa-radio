---
import BaseLayout from '../layouts/BaseLayout.astro';
import { POSTS } from '../data/posts';
import { GALLERY_PLATES } from '../data/gallery';
import { SITE } from '../data/site';

const latestPosts = POSTS.slice(0, 3);
const previewGallery = GALLERY_PLATES.slice(0, 3);
const initialQuote = SITE.randomTransmissions[0];
---

<BaseLayout
  title="首页"
  activeNav="/"
  backdrop="/images/backdrop-main.jpg"
>
  <!-- Act 1: Asymmetric Editorial Hero -->
  <section class="denpa-container denpa-hero">
    <div>
      <p class="denpa-eyebrow">// TRANSMISSION RECEIVED · 2026.01.22</p>
      <h1 class="denpa-hero-title">超时空辉夜姬</h1>
      <p class="denpa-hero-lead">
        这里是一座建在虚拟空间「月读」边缘的小小电波台。收录关于《超かぐや姫！》的官方原画、角色与时间线档案，以及跨越八千年依然在寻找回音的讯号。
      </p>

      <div class="denpa-countdown-block">
        <div class="denpa-countdown-row">
          <span>距离下次月圆重逢还有</span>
          <span class="denpa-countdown-digits" data-denpa-countdown>06:20:27</span>
        </div>
        <p class="denpa-countdown-note">（跨越八千年，它终究不会停在零）</p>
      </div>

      <div class="denpa-actions">
        <a class="denpa-btn-primary" href="/posts/">
          <span>▶ 翻阅放送录</span>
        </a>
        <a class="denpa-btn-ghost" href="/characters/">查阅角色档案</a>
        <a class="denpa-btn-ghost" href="/guestbook/">留下电波讯号</a>
      </div>
    </div>

    <figure class="denpa-hero-plate-wrap">
      <span class="denpa-reticle is-tl" aria-hidden="true"></span>
      <span class="denpa-reticle is-tr" aria-hidden="true"></span>
      <span class="denpa-reticle is-bl" aria-hidden="true"></span>
      <span class="denpa-reticle is-br" aria-hidden="true"></span>
      <div class="denpa-hero-plate">
        <img src="/images/hero-portrait.jpg" alt="星轨之下的钢琴与歌声" />
      </div>
      <figcaption class="denpa-plate-caption">FIG.01 — 星轨之下的钢琴与歌声</figcaption>
    </figure>

    <a class="denpa-scroll-cue" href="#interlude" data-scroll-cue aria-label="向下滚动阅读金句与归档">
      <span>SCROLL TO TUNE</span>
      <i aria-hidden="true">↓</i>
    </a>
  </section>

  <!-- Act 2: Full-Bleed Floating Poetic Quote Interlude + Random Signal Receiver -->
  <section id="interlude" class="denpa-interlude" data-reveal>
    <blockquote
      class="denpa-interlude-quote"
      data-random-quote-text
      data-quotes-json={JSON.stringify(SITE.randomTransmissions)}
    >
      <span set:html={initialQuote.lines[0]} /><br />
      <span set:html={initialQuote.lines[1]} />
    </blockquote>
    <p class="denpa-interlude-source" data-random-quote-source>{initialQuote.source}</p>
    <div class="denpa-quote-tune-wrap">
      <button type="button" class="denpa-tune-btn" data-random-quote-btn>
        <span class="denpa-tune-icon" aria-hidden="true">⟳</span>
        <span data-random-quote-btn-label>接收随机电波</span>
      </button>
    </div>
  </section>

  <!-- Act 3: Latest Transmissions Preview -->
  <section class="denpa-container denpa-section-block" data-reveal>
    <div class="denpa-section-header">
      <div class="denpa-section-header-left">
        <h2 class="denpa-section-title">放送录</h2>
        <span class="denpa-section-en">BROADCASTS</span>
      </div>
      <a class="denpa-section-more" href="/posts/">查看全部 05 篇放送录 →</a>
    </div>

    <div class="denpa-grid-3">
      {latestPosts.map((post, idx) => (
        <a
          class="denpa-card"
          data-route={String(post.routeNum)}
          style={`--stagger: ${idx};`}
          href={`/posts/${post.slug}/`}
        >
          <div class="denpa-card-thumb">
            <img src={post.cover} alt={post.title} loading="lazy" />
          </div>
          <div class="denpa-card-body">
            <div class="denpa-card-meta">
              {post.date} // {post.routeCode} · {post.routeSubtitle}
            </div>
            <h3 class="denpa-card-title">{post.title}</h3>
            <p class="denpa-card-excerpt">{post.excerpt}</p>
            <div class="denpa-tags">
              {post.tags.map((tag) => (
                <span class="denpa-tag">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Act 4: Gallery Preview -->
  <section class="denpa-container denpa-section-block" data-reveal>
    <div class="denpa-section-header">
      <div class="denpa-section-header-left">
        <h2 class="denpa-section-title">回廊</h2>
        <span class="denpa-section-en">GALLERY</span>
      </div>
      <a class="denpa-section-more" href="/gallery/">浏览全部 09 幅原画 →</a>
    </div>

    <div class="denpa-grid-3">
      {previewGallery.map((plate) => (
        <a class="denpa-gallery-tile" href={`/gallery/#${plate.id}`}>
          <img src={plate.src} alt={plate.title} loading="lazy" />
          <div class="denpa-gallery-overlay">
            <span class="denpa-gallery-fig">{plate.fig}</span>
            <span class="denpa-gallery-label">{plate.title}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
